# =============================================
# AI Technical Assessment System - Environment
# =============================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hiring_agent
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/hiring_agent

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_FALLBACK_MODEL=mistral

# App Settings
APP_NAME=AI Technical Assessment System
APP_VERSION=1.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Defaults
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=System Admin
